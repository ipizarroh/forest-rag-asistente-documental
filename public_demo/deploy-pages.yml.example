# INACTIVE DRAFT. Owner approval, protected environment and CI verification required.
# Copy to .github/workflows ONLY after the publication gate. Does not run here.
name: Approved public demo publication
on:
  workflow_dispatch:
    inputs:
      source_sha:
        description: Reviewed full 40-character commit SHA
        required: true
      approval:
        description: Enter PUBLICAR to confirm the reviewed publication
        required: true
permissions:
  contents: read
concurrency:
  group: forestrag-public-demo
  cancel-in-progress: false
jobs:
  build:
    if: github.event.inputs.approval == 'PUBLICAR'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ inputs.source_sha }}
          persist-credentials: false
      - name: Require an exact clean revision
        env:
          EXPECTED_SHA: ${{ inputs.source_sha }}
        run: |
          [[ "$EXPECTED_SHA" =~ ^[0-9a-f]{40}$ ]]
          test "$(git rev-parse HEAD)" = "$EXPECTED_SHA"
          test -z "$(git status --porcelain)"
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: "3.12"
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: "24.22.1"
      - run: python -m pip install --require-hashes -r requirements-lab-linux-py312.lock
      - run: python -m pytest -q tests/test_public_demo.py
      - run: python public_demo/build.py
      - run: node --test public_demo/test_engine.mjs
      - uses: actions/configure-pages@983d7736d9b0ae728b81ab479565c72886d7745b
      - uses: actions/upload-pages-artifact@7b1f4a764d45c48632c6b24a0339c27f5614fb0b
        with:
          path: dist/public-demo
  deploy:
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment:
      name: forestrag-public-demo
      url: ${{ steps.deployment.outputs.page_url }}
    permissions:
      pages: write
      id-token: write
    steps:
      - name: Deploy reviewed artifact
        id: deployment
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e
