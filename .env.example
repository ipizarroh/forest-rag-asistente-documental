# Variables opcionales; la aplicación lee el entorno del proceso.
# Copiar este archivo NO carga variables automáticamente.
FORESTRAG_INDEX=data/forest.db
# Obligatorio para leer un índice: copiar la huella emitida por la construcción confiable.
# Configurar por el operador, fuera del directorio escribible por el escritor del índice.
FORESTRAG_INDEX_SHA256=
FORESTRAG_OLLAMA_MODEL=qwen2.5:3b
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1

